{
  "name": "leaflet-components",
  "version": "0.0.0",
  "description": "Custom elements for creating interactive maps on the web using LeafletJS",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --browser.headless",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier . --write --ignore-unknown",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "leaflet",
    "web components",
    "lit",
    "web maps"
  ],
  "author": "Chris Henrick <info@clhenrick.io> (https://clhenrick.io)",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@types/leaflet": "^1.9.22",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/browser-preview": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "storybook": "^10.5.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-lit": "^1.0.1"
  },
  "dependencies": {
    "leaflet": "2.0.0-alpha.1",
    "lit": "^3.3.3"
  }
}
